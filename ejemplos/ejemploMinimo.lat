###############################################################################
# EJEMPLO MINIMO — Teatro 0.6 (Latino.NET v1.0.81+)
# Autor original de la idea y del motor: Lukeitor (@lukeitorld)
# Uso:
#     latino ejemplos/ejemploMinimo.lat
#
# Nota de ruta: incluir() resuelve relativo al DIRECTORIO DEL SCRIPT DE ENTRADA
# (el archivo que se pasa a `latino`), no al directorio de trabajo. Como este
# ejemplo vive en ejemplos/, el motor se incluye con "../teatro".
###############################################################################

incluir("../teatro")
teatro = CrearTeatro()

# Estructura obligatoria de una escena: diccionario con 4 elementos
#   nombre (cadena), descripcion (cadena), id (decimal),
#   opciones (lista de cadenas; ">vacio<" oculta una opcion).
menu = {
    "nombre": "Menú Principal",
    "descripcion": "Este es el menú",
    "id": 0,
    "opciones": ["Saber más sobre Teatro.>teatro.cambiar_escena(modulo_teatro)<", ">vacio<", "esto no aparece >vacio<"]
}
# En la opción 1, la parte >teatro.cambiar_escena(modulo_teatro)< es la que
# cambia la escena. ">vacio<" hace que la opción no aparezca.

modulo_teatro = {
    "nombre": "Manual de Teatro",
    "descripcion": "Teatro es un módulo creado por Lukeitor para servir como un pequeño motor de juegos narrativos. Lo cual implica que trae una serie de métodos y variables que proveen la arquitectura básica y elemental para hacer un juego de aventuras de texto EN la consola. Teatro vendría a ser el esqueleto básico para diseñar un juego narrativo, pero no un juego en sí mismo.",
    "id": 1,
    "opciones": ["Volver>teatro.cambiar_escena(menu)<", "No aparece>vacio<", "No aparece>vacio<"]
}

funcion iniciar()
    # Borra la consola y carga la información de la escena menu.
    teatro.cambiar_escena(menu)
    jugando = verdadero
    # Bucle central del juego. Se detiene con Ctrl + C o cerrando la consola.
    mientras (jugando)
        escribir("Elige una opcion")
        teatro.procesar_entrada(leer())
    fin
fin

# Llamamos a la función para que comience el juego.
iniciar()
