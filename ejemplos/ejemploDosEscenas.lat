###############################################################################
# EJEMPLO DE DOS ESCENAS — Teatro 0.6 (Latino.NET v1.0.81+)
# Autor original de la idea y del motor: Lukeitor (@lukeitorld)
# Uso:
#     latino ejemplos/ejemploDosEscenas.lat
#
# Muestra tres escenas y cómo ejecutar una función del propio script
# (creditos()) al elegir una opción.
###############################################################################

incluir("../teatro")
teatro = CrearTeatro()

# ==== Escenas ====
menu = {
    "nombre": "Menú Principal",
    "descripcion": "Bienvenido a Teatro, el módulo para crear historias interactivas.\nPara continuar debes presionar el número correspondiente a la opción que deseas seguir (entre paréntesis) y luego apretar enter.",
    "id": 0,
    "opciones": ["¿Cómo lo uso? >teatro.cambiar_escena(manual)<", "Saber más sobre Latino.>teatro.cambiar_escena(latino)<", "Ejecutar una función del script>creditos()<"]
}

manual = {
    "nombre": " Manual de Teatro ",
    "descripcion": "Teatro es un módulo creado por Lukeitor para servir como un pequeño motor de juegos narrativos.\nLo cual implica que trae una serie de métodos y variables que proveen la arquitectura básica y elemental para hacer un juego de aventuras de texto EN la consola.\nTeatro es el esqueleto básico para diseñar un juego narrativo, no un juego en sí mismo.\nEn la versión 0.6 el motor corre sobre Latino.NET v1.0.81.",
    "id": 1,
    "opciones": ["volver.>teatro.cambiar_escena(menu)<", "opcion2. >vacio<", "opcion3 >vacio<"]
}

latino = {
    "nombre": " Sobre Latino ",
    "descripcion": "Latino es un lenguaje de programación con sintaxis en Español, desarrollado en el 2015. Este lenguaje está inspirado en Python y Lua. Latino.NET es su continuación moderna sobre .NET.",
    "id": 2,
    "opciones": ["volver.>teatro.cambiar_escena(menu)<", "opción 2.>vacio<", "opción 3.>vacio<"]
}

# ==== Comenzar ====
funcion iniciar()
    teatro.cambiar_escena(menu)
    jugando = verdadero
    mientras (jugando)
        escribir("Elige una opcion")
        teatro.procesar_entrada(leer())
    fin
fin

# Función externa al módulo, ejecutada desde una opción al colocarse su
# nombre entre > < .
funcion creditos()
    escribir("Se ejecuta la función creditos()")
    escribir("Teatro fue creado por Lukeitor como un proyecto de interés académico para probar los límites del lenguaje Latino.\nEl resultado es que todo funciona correctamente aunque es quisquilloso a veces.\nLa v0.6 migra el motor a Latino.NET v1.0.81 usando el patrón Factory.")
fin

iniciar()
