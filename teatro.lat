###############################################################################
# PROGRAMA: Teatro 0.6
# CREADO  : Enero del 2026 (v0.1-v0.5, Lukeitor) · Noviembre del 2026 (v0.6)
# VERSION : 0.6
# AUTOR   : Lukeitor (@lukeitorld) — idea, arquitectura de escenas y motor original
#           Migración a Latino.NET v1.0.81 : Lázaro / FrkL81
# OBJETIVO: Motor de juegos de texto interactivo para la consola.
# PATRON  : Factory (CrearTeatro) con estado privado (local) + clonar() en el
#           historial. Sin contaminar el ambito global.
# COMPAT  : Latino.NET v1.0.81 o superior.
#
# Cambios de v0.5 a v0.6:
#   - incluir("teatro") ya no se asigna: incluir devuelve nulo en v1.0.81.
#     Ahora se instancia con  teatro = CrearTeatro().
#   - El estado es local a la fabrica (encapsulado) y se devuelve por interfaz.
#   - historia guarda CLONES (clonar) para evitar el aliasing de v0.5.
#   - armar_cuerpo parte por palabras y respeta el ancho (fix del desbordamiento).
#   - procesar_entrada valida igualdad exacta ("1", "2", "3"), no contiene.
#   - Se eliminan las auto-referencias rotas teatro.metodos.* / teatro.estado.*.
###############################################################################

funcion CrearTeatro(configUsuario = nulo)

    # -- 1. Configuracion por defecto, fusionable por el usuario ---------------
    local config = {
        "ancho": 100
    }
    si configUsuario != nulo
        para k en dic.llaves(configUsuario)
            config[k] = configUsuario[k]
        fin
    fin

    # -- 2. Estado privado del motor -------------------------------------------
    local estado = {
        "colores" : {
            "resetear"  : "\033[0m",
            "negrita"   : "\033[1m",
            "italicas"  : "\033[3m",
            "subrayado" : "\033[4m",
            "parpadeo"  : "\033[5m",
            "tachado"   : "\033[9m ",
            "titulo"    : "\033[38;2;0;191;255m",
            "subtitulo" : "\033[38;2;30;58;138m",
            "texto"     : "\033[38;2;192;192;192m",
            "opciones"  : "\033[38;2;64;224;208m",
            "exito"     : "\033[38;2;255;215;0m",
            "mal"       : "\033[38;2;220;20;60m",
            "resaltado" : "\033[38;2;138;43;226m"
        },
        "configuracion" : config,
        "historia" : [],
        "escena_actual" : {
            "nombre" : "",
            "descripcion" : "",
            "id" : 0,
            "opciones" : []
        },
        "escena_anterior" : {
            "nombre" : "",
            "descripcion" : "",
            "id" : 0,
            "opciones" : []
        }
    }

    # -- 3. Utilidades internas -------------------------------------------------

    # Texto visible de una opcion: lo que esta antes del marcador ">"
    local extraer_texto = funcion(opcion)
        local idx = cadena.ultimo_indice(opcion, ">")
        si idx < 0
            retornar opcion
        fin
        retornar cadena.recortar(cadena.subcadena(opcion, 0, idx))
    fin

    # Centra el titulo entre bordes "="
    local centrar_encabezado = funcion(texto)
        local ancho = estado.configuracion.ancho
        local largo = mate.abs((ancho - cadena.longitud(texto)) / 2)
        si (cadena.longitud(texto) + largo * 2) >= ancho
            largo = largo - 1
        fin
        si largo < 0
            largo = 0
        fin
        local bordes = ""
        repetir
            bordes = bordes .. "="
        hasta (cadena.longitud(bordes) >= largo)
        retornar bordes .. texto .. bordes
    fin

    # Particion por palabras: acumula hasta el ancho sin cortar palabras.
    # Solo trocea una palabra cuando ella sola supera el ancho (inevitable).
    local ajustar_parrafo = funcion(texto, ancho)
        local palabras = cadena.separar(texto, " ")
        local total = lista.longitud(palabras)
        local linea = ""
        local salida = ""
        local j = 0
        local w = ""
        mientras j < total
            w = palabras[j]
            si cadena.longitud(w) > 0
                si cadena.longitud(w) > ancho
                    si cadena.longitud(linea) > 0
                        salida = salida .. linea .. "\n"
                        linea = ""
                    fin
                    mientras cadena.longitud(w) > ancho
                        salida = salida .. cadena.subcadena(w, 0, ancho) .. "\n"
                        w = cadena.subcadena(w, ancho, cadena.longitud(w) - ancho)
                    fin
                    linea = w
                sino
                    si cadena.longitud(linea) == 0
                        linea = w
                    osi (cadena.longitud(linea) + 1 + cadena.longitud(w)) <= ancho
                        linea = linea .. " " .. w
                    sino
                        salida = salida .. linea .. "\n"
                        linea = w
                    fin
                fin
            fin
            j = j + 1
        fin
        si cadena.longitud(linea) > 0
            salida = salida .. linea .. "\n"
        fin
        retornar salida
    fin

    # Envuelve el texto al ancho, respetando parrafos ("\n") y palabras.
    local armar_cuerpo = funcion(descripcion)
        local ancho = estado.configuracion.ancho
        local parrafos = cadena.separar(descripcion, "\n")
        local total = lista.longitud(parrafos)
        local salida = ""
        local i = 0
        mientras i < total
            local p = cadena.recortar(parrafos[i])
            si cadena.longitud(p) == 0
                salida = salida .. "\n"
            sino
                salida = salida .. ajustar_parrafo(p, ancho) .. "\n"
            fin
            i = i + 1
        fin
        retornar salida
    fin

    # Lineas visibles de las opciones (la numeracion sigue la posicion real).
    local procesar_opciones = funcion(opciones)
        local visibles = []
        local total = lista.longitud(opciones)
        local i = 0
        mientras i < total
            local op = opciones[i]
            si no cadena.contiene(op, ">vacio<")
                lista.agregar(visibles, "(" .. acadena(i + 1) .. ") " .. extraer_texto(op))
            fin
            i = i + 1
        fin
        retornar visibles
    fin

    # Ejecuta el comando embebido en una opcion (sintaxis del autor: >comando<).
    local procesar_opcion = funcion(opcion)
        si cadena.contiene(opcion, ">vacio<")
            retornar falso
        fin
        local idxA = cadena.ultimo_indice(opcion, ">")
        local idxB = cadena.ultimo_indice(opcion, "<")
        si idxA < 0 ó idxB < 0 ó idxB <= idxA
            escribir(estado.colores.mal .. "Entrada incorrecta, intenta de nuevo." .. estado.colores.resetear)
            retornar falso
        fin
        local comando = cadena.subcadena(opcion, idxA + 1, idxB - idxA - 1)
        si cadena.longitud(comando) == 0
            retornar falso
        fin
        cadena.ejecutar(comando)
        retornar cierto
    fin

    # Validacion exacta de la entrada: solo "1", "2" o "3".
    local procesar_entrada = funcion(entrada)
        local e = cadena.recortar(acadena(entrada))
        si e == "1" ó e == "2" ó e == "3"
            local idx = anumero(e) - 1
            si idx < lista.longitud(estado.escena_actual.opciones)
                procesar_opcion(estado.escena_actual.opciones[idx])
            fin
        sino
            cambiar_escena(estado.escena_actual)
            escribir(estado.colores.mal .. "Entrada incorrecta, recuerda que solo valen las entradas 1, 2 y 3." .. estado.colores.resetear)
        fin
    fin

    # -- 4. Metodo principal: carga y renderiza una escena ---------------------
    local cambiar_escena = funcion(escena)
        # archivar la escena actual (clonada: evita el aliasing de v0.5)
        lista.agregar(estado.historia, clonar(estado.escena_actual))
        # OJO: en v1.0.81 los diccionarios solo admiten LECTURA por punto;
        # la escritura exige corchetes (d["clave"] = valor).
        estado["escena_anterior"] = clonar(estado.escena_actual)
        estado["escena_actual"] = clonar(escena)

        limpiar()
        local titulo = centrar_encabezado(estado.escena_actual.nombre)
        escribir(estado.colores.negrita .. estado.colores.subrayado .. estado.colores.titulo .. "╞ " .. titulo .. "╣" .. estado.colores.resetear)

        local cuerpo = armar_cuerpo(estado.escena_actual.descripcion)
        escribir(estado.colores.texto .. cuerpo .. estado.colores.resetear)

        local visibles = procesar_opciones(estado.escena_actual.opciones)
        si lista.longitud(visibles) > 0
            escribir(estado.colores.opciones .. lista.separar(visibles, "\n") .. estado.colores.resetear)
        fin
    fin

    # -- 5. Interfaz publica ----------------------------------------------------
    retornar {
        "estado": estado,
        "cambiar_escena": cambiar_escena,
        "procesar_entrada": procesar_entrada,
        "procesar_opcion": procesar_opcion,
        "armar_cuerpo": armar_cuerpo,
        "centrar_encabezado": centrar_encabezado
    }
fin
